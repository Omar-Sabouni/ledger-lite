# Local credentials. Keep these URL-safe and replace them
# before sharing a workstation. Docker Compose does not publish PostgreSQL; the
# bootstrap password is nulled after initialization and the migrator login is
# disabled after every migration/grant cycle.
LEDGERLITE_BOOTSTRAP_PASSWORD=ledgerlite
LEDGERLITE_MIGRATOR_PASSWORD=ledgerlite-migrator-local
LEDGERLITE_APP_PASSWORD=ledgerlite-app-local

# Direct host-side development (Docker Compose overrides DATABASE_URL for each
# service and never gives the API the migrator credential).
APP_ENV=local
DATABASE_URL=postgresql+psycopg://ledgerlite_app:ledgerlite-app-local@localhost:5432/ledgerlite
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
LOG_LEVEL=INFO
